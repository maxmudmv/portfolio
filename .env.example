# Public site URL (used for canonical URLs, sitemap, Open Graph, and hreflang)
NEXT_PUBLIC_SITE_URL=https://maxmudmv.vercel.app

# Contact Form Email Delivery (Optional - Resend API)
# Obtain an API key at https://resend.com
# If left empty, the contact form honestly informs visitors that direct automated
# email delivery is not configured and provides a 1-click mailto/Telegram fallback.
RESEND_API_KEY=

# Destination email address for contact form submissions
CONTACT_RECEIVER_EMAIL=elmurodovmaxmud8@gmail.com
